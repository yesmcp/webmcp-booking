---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, for the canonical URL. Leading slash, e.g. "/privacy/". */
  path?: string;
  /** og:title, when the social title differs from the <title> tag. */
  ogTitle?: string;
  /** og:description, when the social blurb differs from the meta description. */
  ogDescription?: string;
  /** Site-root-relative og image, e.g. "/assets/og/home.png". */
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  /** Set on pages that must stay out of the index (404). */
  noindex?: boolean;
  /** Content language of the page. Drives <html lang>, og:locale and the
   * cyrillic font preloads. URL paths use /ua/, but the LANGUAGE code for
   * Ukrainian is "uk" (ISO 639-1) — hreflang="ua" would be silently ignored
   * by Google, so never "fix" this to match the path. */
  lang?: "en" | "uk";
  /** Paths of this page's translations, keyed by language code, e.g.
   * { en: "/about/", uk: "/ua/about/" }. When set, bidirectional hreflang
   * alternates are rendered (x-default → the English page). Only pass this
   * on pages that actually have both versions. */
  alternates?: { en: string; uk: string };
}

const {
  title = "yesmcp: your business inside AI chats",
  description =
    "Ask an assistant to book something with your business: today it cannot. yesmcp builds and runs the connector that lets your customers book, order and get answers inside Claude and ChatGPT.",
  path = "/",
  ogTitle,
  ogDescription,
  ogImage = "/assets/og/home.png",
  ogType = "website",
  noindex = false,
  lang = "en",
  alternates,
} = Astro.props;

const ogImageUrl = new URL(ogImage, "https://yesmcp.com/").href;
const ogLocale = lang === "uk" ? "uk_UA" : "en_US";
const ogLocaleAlt = lang === "uk" ? "en_US" : "uk_UA";
const abs = (p: string) => new URL(p, "https://yesmcp.com/").href;

// Directory reviewers compare the submitted privacy URL against the page they
// land on, so every page must be canonical to ITSELF — a site-wide canonical
// pointing at the homepage would make /privacy look like a duplicate.
const siteUrl = new URL(path, "https://yesmcp.com/").href;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* A canonical on a noindex page is contradictory signalling, and on /404
        it named a URL that resolves to nothing (site audit, 2026-08-29). */}
    {!noindex && <link rel="canonical" href={siteUrl} />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="uk" href={abs(alternates.uk)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />
      </>
    )}
    {/* A page with no twin still declares its own language, so the three
        English-only articles stop being the only indexable pages on the site
        without hreflang at all (site audit, 2026-08-29). */}
    {!alternates && !noindex && (
      <link rel="alternate" hreflang={lang} href={siteUrl} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "uk" ? "yesmcp: нотатки" : "yesmcp: writing"}
      href={lang === "uk" ? "/ua/rss.xml" : "/rss.xml"}
    />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content={ogLocale} />
    {alternates && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {/* Three declarations on purpose (2026-08-27): Google's favicon docs list ICO/PNG
        and never name SVG, so a search engine gets an unambiguous raster — 192px,
        because Google asks for more than 48. Browsers keep preferring the SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {/* Fonts are self-hosted (src/styles/fonts.css) — nothing is fetched from a
        third-party domain. Fixel files carry latin AND cyrillic in one file,
        so the same two render-critical preloads serve every language: the
        heading cut (h1/nav are font-800) and the body face. `crossorigin` is
        mandatory even same-origin, or the preload is fetched twice. */}
    <link
      rel="preload"
      href="/assets/fonts/fixel-display-extrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/fixel-text-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="grain antialiased">
    <slot />
    <script is:inline type="module" src="/js/reveal.js"></script>
  </body>
</html>
