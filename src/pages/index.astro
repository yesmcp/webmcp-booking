---
import Layout from "../layouts/Layout.astro";
import LangTag from "../components/LangTag.astro";
import SiteLogo from "../components/SiteLogo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HeroChatStories from "../components/HeroChatStories.astro";
import BrandIcon from "../components/BrandIcon.astro";
import BelieverGate from "../components/BelieverGate.astro";
import TwoFaces from "../components/TwoFaces.astro";
import { siClaudecode, siGooglegemini, siPerplexity, siGithubcopilot, siOllama } from "simple-icons";

// The four questions an owner asks before writing to us. Declared up here
// because the FAQPage node below is generated from this exact array: one home
// per fact, so the page and the structured data can never drift apart.
const faqs = [
  {
    q: "Couldn't my own developer build this?",
    a: "He will. The question is not who writes the server: it is who decides which five of your customers' questions belong in a chat, where the line sits that the assistant may never cross, and who is watching on Friday evening when a scenario starts answering wrongly. We work with your developers on exactly that.",
  },
  {
    q: "How do my customers actually get the connector?",
    a: "Today: a one-link install page. A customer adds your connector to Claude in under a minute, on any plan. In ChatGPT the path is the official app directory: OpenAI reviews every submission, and when you want a place there, we prepare and shepherd your submission through that review. We tell you exactly what works today versus what is pending review.",
  },
  {
    q: "What about our data and security?",
    a: "Your data stays in your systems: the connector reads them with scoped credentials, not direct database access. Read and write are separated, and irreversible actions ask for confirmation before they fire. A guest booking stores a name and an email, and that is all; when a scenario truly needs identity, we build it on OAuth 2.1 and run that in production too. And we attack our own server with forged headers and hostile payloads before anyone else gets the chance.",
  },
  {
    q: "What does it cost, and why is there no price here?",
    a: "Because every connector is scoped to one business, and a number without that scope would be a guess. The diagnosis is free, and you leave that free step with a number for your case. Two commitments stand in for a price list: if the first scenario turns out to be the wrong one, we build the next one from your map at no extra cost; and against a system with an API, the first scenario takes about two weeks.",
  },
  {
    q: "Will I be locked into you?",
    a: "No. The spec and code belong to you from day one, and you can move the connector to your own servers whenever you choose. We keep clients by the work, not by the lock.",
  },
];

// Structured data for the home page. The @id nodes are shared with /about/,
// /privacy/ and every article, so search engines merge one Organization and
// one Person across the site instead of seeing four of each.
// Everything here is checkable on the site itself — no awards, no address,
// no employee count, no founding date we cannot evidence.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://yesmcp.com/#organization",
      name: "Yes MCP",
      alternateName: "yesmcp",
      url: "https://yesmcp.com/",
      email: "yes@yesmcp.com",
      description:
        "Yes MCP designs, ships and runs Model Context Protocol connectors for businesses, so their customers can book, order, check status and get support inside AI chats such as Claude and ChatGPT.",
      founder: { "@id": "https://yesmcp.com/#serhii" },
      sameAs: [
        "https://www.linkedin.com/company/yesmcp/",
        "https://github.com/yesmcp",
        "https://x.com/YesMCPapp",
        "https://www.youtube.com/@YesMCPapp",
        "https://t.me/yesmcp",
        "https://www.producthunt.com/@yesmcpapp",
      ],
      knowsAbout: [
        "Model Context Protocol",
        "MCP connectors",
        "MCP Apps",
        "OAuth 2.1",
        "AI assistant integration",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: "yes@yesmcp.com",
        url: "https://t.me/yesmcp_bot",
        availableLanguage: ["en", "uk"],
      },
    },
    {
      "@type": "Person",
      "@id": "https://yesmcp.com/#serhii",
      name: "Serhii Kravchenko",
      jobTitle: "AI engineer",
      url: "https://yesmcp.com/about/",
      sameAs: [
        "https://www.linkedin.com/in/awrshift/",
        "https://x.com/awrshift",
        "https://github.com/awrshift",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://yesmcp.com/#website",
      url: "https://yesmcp.com/",
      name: "yesmcp",
      description:
        "MCP connectors for businesses: your bookings, orders, catalog and support, available to your customers inside Claude and ChatGPT.",
      publisher: { "@id": "https://yesmcp.com/#organization" },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": "https://yesmcp.com/#webpage",
      url: "https://yesmcp.com/",
      name: "yesmcp: your business inside AI chats",
      isPartOf: { "@id": "https://yesmcp.com/#website" },
      about: { "@id": "https://yesmcp.com/#organization" },
      inLanguage: "en",
    },
    // The FAQ block, machine-readable. Google rarely renders FAQ rich results
    // for a site like ours any more; the reason this is here is the other
    // reader — assistants that quote answers about MCP connectors. Text is
    // generated from `faqs`, never retyped.
    {
      "@type": "FAQPage",
      "@id": "https://yesmcp.com/#faq",
      isPartOf: { "@id": "https://yesmcp.com/#webpage" },
      inLanguage: "en",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

// icon = BrandIcon slug; chatgpt stays text-only on purpose (see BrandIcon.astro).
//
// hostsCheckedAt is set BY HAND, on the day someone actually re-checks the
// platform notes below. It is not a build date and must never be derived from
// one: the claim "we track it" is only worth anything if the date under it is
// the date of a real check. Same string in the /ua/ mirror.
const hostsCheckedAt = "31 Aug 2026";
const customerHosts = [
  { name: "claude.ai", note: "live · all plans", icon: "claude" },
  { name: "chatgpt", note: "via app directory review", icon: null },
  { name: "le chat", note: "live · free tier", icon: "mistral" },
  { name: "perplexity", note: "pro plans", icon: "perplexity" },
  { name: "gemini", note: "limited preview", icon: "gemini" },
];

// The agent crew jogging the why-now bridge behind Claude Code. Every glyph is
// an official mark inlined from simple-icons, and every one of these clients
// speaks MCP today — that is the whole point of putting them on the bridge.
//
// NEVER give the runners different durations. animateMotion is paced, so one
// shared period plus evenly spaced starts keeps the gap between them constant
// (path length / 5, roughly 125 user units, several icon widths). Unequal
// periods drift and the runners eventually walk through each other.
const BRIDGE_DUR = "6.5s";
const bridgeAgents = [
  { icon: siGooglegemini, begin: "-3.9s", hop: "-0.12s", scale: 0.8 },
  // Perplexity's mark is a thin outline: at 0.8 it dissolves on paper, so it
  // runs a size up. `hop` only desyncs the CSS bounce, never the position.
  { icon: siPerplexity, begin: "-2.6s", hop: "-0.31s", scale: 0.95 },
  { icon: siGithubcopilot, begin: "-1.3s", hop: "-0.22s", scale: 0.8 },
  { icon: siOllama, begin: "0s", hop: "-0.05s", scale: 0.85 },
];

// The steps are told in the READER's currency, not ours (board, 2026-08-26).
// Every headline used to start with "We" — 174 words about our process on a
// page where the owner is asking what it costs him. `cost` is what he actually
// spends at that step, and it is the first thing he reads on each row.
//
// The mono props that used to hang under each step (`audit → scenarios.yaml`,
// `auth: guest or oauth 2.1`, `deploy → status: in production`) are gone: mono
// is reserved for machine output, those strings were a costume aimed at a
// developer who is not our buyer, and the last one restated the live counter in
// #proof, which is the version with evidence behind it. Directory submission
// moved out of step 3 as well — it is conditional, and the FAQ already answers
// it in full.
//
// The rail below the list carries the sequence, so the numerals no longer have
// to shout it: hollow ring = a step still ahead, filled green node = the
// result, the same vocabulary the bridge uses. It runs down the left edge on a
// phone, where rows stack naturally and no carousel is needed, and turns
// horizontal from md up, where three columns are simply more compact.
const steps = [
  {
    n: "01",
    cost: "one call",
    title: "You pick the scenarios",
    text: "We look at your website, CRM, booking and catalog, and you decide which of it your customers and your team should be able to do inside a chat.",
  },
  {
    n: "02",
    cost: "access and one person to ask",
    title: "We build against your systems",
    text: "You give scoped access to what already runs your business. We design the tools, add the guardrails, and test on real conversations.",
  },
  {
    n: "03",
    cost: "nothing on your side",
    title: "A link for customers, a login for your team",
    text: "The connector goes live: customers install it with one link, your team signs in. We watch it daily after that and keep improving it.",
  },
];

// The collapsed "technical receipts" block and the founding-clients card were
// removed by the owner (31.08).

// Fallback numbers for the live status strip. public/js/live-status.js
// overwrites them from https://mcp.yesmcp.com/status; when that call fails,
// what stays on screen is exactly this.
//
// No clock in the strip, by decision: neither a running day count nor a launch
// date. Both answer "how long have you existed", which is not the question the
// reader is asking, and on a young project the answer argues against us. The
// strip carries what makes the connector worth trusting instead: it is live,
// it is serving, and its answers come from the client's own data. startedAt
// stays in the data because /status reports it, not because we display it.
const liveFallback = {
  startedAt: "2026-08-21",
  tools: 10,
};

// Scenario catalog, two shelves of THREE (symmetry is the owner's call,
// 31.08; "your business" closes the whole slab as a full-width band instead
// of riding the light shelf as an orphan fourth card). Each card is an
// artifact: the line a person types, the tool it fires, the result. The card
// ids are load-bearing anchors for future vertical articles — do not rename
// them, even where a quote has moved on (s-team-day). Tool rows speak plain
// verbs, not `journal.read` syntax — same reason the hero and the two faces
// dropped it: the buyer is not a developer. Quotes avoid retelling the two
// screen-4 transcripts (open-the-day, move-a-booking), which they duplicated
// before the 31.08 redesign.
const customerCases = [
  {
    id: "s-education-homework",
    tag: "language school",
    quote: "What's my son's homework for Thursday, and how is he doing?",
    tool: "reads the class journal",
    result: "Homework, progress notes and what the group covered, read from your class journal rather than a group-chat scroll.",
    services: [["gsheets", "Google Sheets"], ["gcal", "Google Calendar"]],
  },
  {
    id: "s-accounting-docs",
    tag: "accounting firm",
    quote: "What do you still need from me for the quarterly filing?",
    tool: "builds your checklist",
    result: "A list built from your own records: which documents are already in, which are missing, and a secure link to upload the rest.",
    services: [["quickbooks", "QuickBooks"], ["gdrive", "Google Drive"]],
  },
  {
    id: "s-shop-order",
    tag: "online shop",
    quote: "Where is my order?",
    tool: "checks the order",
    result: "A customer who ordered in the chat asks in the same chat: a live answer from your system's data, not a support ticket.",
    services: [["shopify", "Shopify"], ["woocommerce", "WooCommerce"]],
  },
];

const teamCases = [
  {
    id: "s-team-day",
    tag: "clinic front desk",
    quote: "Who's coming at 11:00, and where did we leave off?",
    tool: "reads the schedule and visit notes",
    result: "Today's schedule plus the client's history, read from your systems before the person walks in.",
    services: [["gcal", "Google Calendar"], [null, "your clinic system"]],
  },
  {
    id: "s-team-attention",
    tag: "agency partner",
    quote: "What needs attention this week?",
    tool: "reads CRM, tracker and books",
    result: "Stale proposals, unbilled work and overdue invoices in one answer instead of three tabs.",
    services: [["hubspot", "HubSpot"], ["jira", "Jira"], ["quickbooks", "QuickBooks"]],
  },
  {
    id: "s-team-write",
    tag: "any team",
    quote: "Ihor paid in cash. Log it and book his next visit.",
    tool: "logs the payment, books the visit",
    result: "Write actions run behind a login and are confirmed before they fire: sanctioned, scoped, auditable.",
    services: [["quickbooks", "QuickBooks"], ["gcal", "Google Calendar"]],
  },
];

// "Your business" is the catalog's shared close, speaking for both shelves.
// The anchor id survives from its card era. No link to the scenario map here
// on purpose: the map lives in exactly two places on this page (hero and the
// finale), a decided CTA hierarchy.
const yourScenario = {
  id: "s-your-scenario",
  tag: "your business",
  quote: "Can my customers and my team do this in a chat too?",
  result: "Almost any system can be connected. The scenario map is the fastest way to see yours.",
  chip: "your own system",
};

// Two shelves, one object: the catalog renders as a single bordered slab split
// Phones get each shelf as a horizontal snap row (the services widget's own
// pattern, peek included): 12 stacked cards were ~5 screens. From sm up it is
// the plain grid again. No JS, and every card stays in the DOM, so the anchor
// ids keep working. (Kept as a JS comment: an HTML comment inside the loop is
// emitted into production HTML, once per shelf.)
// into a light half (the public side: a guest, no login) and a dark half (the
// side behind a login), with a milled coin edge between them. `dark` drives the
// card theme; `status` is the one-line reminder of which side the reader is on.
const caseShelves = [
  { label: "Your customers", status: "guest · no login", dark: false, note: null, strip: false, cards: customerCases },
  {
    label: "Your team",
    status: "signed in",
    dark: true,
    // The strip under this note makes the against-point-solutions argument:
    // every tool below ships its own single-tool connector the team could add
    // by hand; our product is the system that unites them.
    note: "Every tool below ships its own single-tool connector. Our work is the system: all of them, plus your custom software, wired into one place under your rules.",
    strip: true,
    cards: teamCases,
  },
];

// What-we-build hierarchy (board verdict, docs/plans/2026-08-25-offer-expansion.md):
// one connector, two faces (customer / team), widgets as the finishing level,
// the scenario map as step zero. Deliberately NOT a menu of equal services.
//
// The `included` trio that used to live here (hosting / security / yours to
// keep) was rendered twice on one page: as the hero demo's own cards and again
// at the foot of #build, word for word, ten screens apart. The hero demo keeps
// it — there it is the product demonstrating itself — and #build states it in
// one line. One home per fact (removed 2026-08-26).

// ─────────────────────────────────────────────────────────
// Notes on the markup below. They live here as JS comments, not as
// HTML comments in the template: an HTML comment ships to production
// and is readable in page source, which is how internal rationale
// ended up public (found by the design review, 2026-08-26).
// ─────────────────────────────────────────────────────────
//
// On phones the hero's own CTA is one scroll-free tap away; the header
// slot is better spent on the only nav links a phone user gets.
// The pill carries the PRIMARY action of the whole page (owner,
// 2026-08-26): the free scenario map, not the scoping call. A first
// visitor has no price and no way to check us, so the cheapest move
// that still returns something about THEIR business wins the slot.
//
// One viewport, deliberately. At lg+ the hero is a two-column layout that
// vertically centres inside `min-h-svh`, so the whole chat card — through the
// last message — sits above the fold on a 1280×800 laptop. The H1 clamp is
// capped low enough that the headline cannot push the card down.
// Below lg it stacks and scrolls naturally; the phone is not asked to fit it.
//
// The 900M figure is told ONCE per screen, not three times: the H1
// carries it here, the why-now section carries it with its
// attribution. This eyebrow used to repeat both.
//
// Readiness, not loudness, sets the order (owner, 2026-08-26): a
// first-time visitor has no quote to compare and no client of ours to
// call, so the loudest button is the cheapest move that returns
// something about their own business. "Start a project" keeps its
// place as the second, higher-commitment option.
//
// The free move, one screen in: our own connector is live and anyone
// can add it in a minute. Everything below the fold argues that we can
// build one; this lets the reader check it instead.
// NO raw URL and no copy button here, deliberately (owner, 2026-08-26):
// you cannot paste a connector URL into a chat, it goes into a settings
// dialog — a technical step our reader does not know and should not have
// to. The button opens /connect/, where the prefilled install link does
// that step for them; the manual URL lives there too, for whoever wants it.
//
// interactive chat demo (see components/HeroChatStories.astro)
//
// Prose, so it is not set in mono any more (2026-08-26 type pass): the
// monospace face means "a machine produced this" — a tool call, a status,
// a code-shaped value. A sentence about us is none of those.
//
// The "living graphic": travellers cross a dashed arc from the AI-chat side
// to the business side. Animation is SMIL (<animateMotion>) inside inline
// SVG — zero JS, so the CSP stays untouched; reduced-motion hides the
// travellers via .bridge-traveler in global.css. The 900M figure is
// OpenAI's own (Feb 2026, WAU) — keep the attribution line when editing.
//
// The arc warms from ink to green towards your side: the visual
// claim of the section, made by the line itself.
//
// The AI-agent crew on the bridge, owner-picked lineup: the
// official Claude Code mascot glyph (with a blinking terminal
// caret) leads; Gemini, Perplexity, GitHub Copilot and Ollama
// jog along smaller. All glyphs come inlined from simple-icons
// (traced from the vendors' official sites); OpenAI/ChatGPT is
// absent there at the brand owner's request, so it cannot join.
// Same SMIL machinery as the traveller dots: zero JS, and
// reduced-motion hides every runner via .bridge-traveler.
//
// Payout burst. Every runner shares one period, so an arrival
// lands exactly every BRIDGE_DUR / 5 = 1.3s: the ring and the
// "+$" ride that beat. Both are SMIL, on the same clock as the
// runners, because a CSS animation would drift out of step with
// them; .bridge-payout is the handle reduced-motion hides.
//
// One product, presented as a hierarchy, not a menu: the connector is the
// noun; customer/team are its two faces; widgets are the finishing level;
// the scenario map is step zero. Wording is locked by the offer board
// (docs/plans/2026-08-25-offer-expansion.md) — check its vocabulary rules
// before editing this copy.
//
// Step zero used to be a bordered box with its own vertical connector
// below it: a fourth stacked object before the reader reached the product.
// It is the same sentence, but now it hangs off the headline on one dashed
// rail — part of the opening statement, not a separate announcement.
//
// The two faces: two chat moments instead of widget mocks (owner, 31.08;
// rationale lives in components/TwoFaces.astro). Stacked on phones, no
// carousel.
//
// Two levels used to live here where one does: a six-line essay on why
// cards beat text, plus the "every build includes" trio, which repeated
// the hero demo's own cards word for word. The claim that is actually
// checkable survives; the essay and the duplicate do not.
//
// The thread. Dashed line = the path, hollow rings = steps still on the
// way, the filled green node = the result. Same vocabulary as the bridge
// and the assembly threads in "what we build"; decorative, so it is
// hidden from assistive tech and only drawn where the steps sit side by
// side.
//
// Same snap carousel as the scenario shelves: from md up
// the three steps are one hairline-divided object, on a phone they are
// three swipeable cards instead of 1750px of stacked argument. The
// divider trick (gap-px over a light background) only exists in the grid
// form, so each card carries its own border below md.
//
// The question every owner asks after the three steps: where does the
// answer come from, and is it current? Answering it in prose costs a
// paragraph nobody reads; showing the source row next to the sentence it
// becomes costs one strip. The highlighted row is the edit — same price on
// both sides, no sync step in between.
//
// A deliberate rest between the catalog and the proof: five screens of
// bordered cards in a row is why the scroll felt relentless. No card, no
// border box, no eyebrow, no CTA — one dashed rail ending in the green node,
// the same vocabulary the bridge and the three steps use, and one sentence
// that turns the page from "what a connector can do" to "what ours does".
// py-16, deliberately less than the py-24 every real section uses: this is a
// beat, not a section.
//
// Three layers a non-technical owner can verify by themselves (live status,
// results, the three fears). The numbers in the strip are live:
// public/js/live-status.js reads https://mcp.yesmcp.com/status and, if that
// fails, leaves the fallback values rendered here untouched.
//
// One case, because we have one (owner, 2026-08-26). Two "open slot" cards
// used to sit beside it: in a section headed "proof you can check", two of
// three cases advertised the absence of clients.
//
// The three fears ride the same carousel on a phone: stacked, they were
// three more full-height arguments in a section that already carries the
// live strip and the case.

---

<Layout alternates={{ en: "/", uk: "/ua/" }}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <!-- ── nav ─────────────────────────────────── -->
  <header class="fixed inset-x-0 top-0 z-40 border-b border-ink/10 bg-paper/80 backdrop-blur-md">
    <nav class="relative mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5">
      <a href="#" aria-label="yesmcp">
        <SiteLogo className="h-[22px] w-auto" />
      </a>
      <div class="flex items-center gap-5 text-sm text-ink-soft sm:gap-7">
        <a href="#build" class="link-und hidden sm:inline">What we build</a>
        <a href="#cases" class="link-und hidden sm:inline">Scenarios</a>
        <a href="#proof" class="link-und hidden sm:inline">Proof</a>
        <a href="/connect/" class="link-und text-yes-deep">Try it</a>
        <a href="/writing/" class="link-und">Writing</a>
        <a href="/about/" class="link-und">About</a>
        <a href="/scenario-map/"
          class="hidden rounded-full bg-ink px-4 py-1.5 font-medium text-paper transition-all hover:-translate-y-0.5 hover:bg-yes-deep sm:inline-block">
          Get your map
        </a>
      </div>
      <LangTag target="uk" href="/ua/" />
    </nav>
  </header>
  <main>

  <!-- ── hero ────────────────────────────────── -->
  <section
    class="relative mx-auto flex max-w-6xl flex-col justify-center px-5 pt-28 pb-14 sm:pt-32 lg:min-h-svh lg:pt-24 lg:pb-12">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-12 xl:gap-16">
      <div>
        <p class="rise font-mono text-xs text-ink-faint" style="--i:0">
          your business · <span class="text-yes-deep">inside claude and chatgpt</span>
        </p>

        <h1 class="rise mt-3 font-display text-[clamp(1.9rem,4.2vw,3.1rem)] leading-[1.1] font-800" style="--i:1">
          Ask an assistant to book<br />
          something with your business.<br />
          <span class="text-yes">Today it cannot.</span>
        </h1>

        <p class="rise mt-5 max-w-xl leading-relaxed text-ink-soft sm:text-lg" style="--i:2">
          <strong class="text-ink">yesmcp</strong> builds and runs the
          connector that lets your customers book, order and get answers from
          your business right inside Claude or ChatGPT. Like the one in this
          chat: it is real, and you can try it.
        </p>
        <div class="rise mt-10" style="--i:3">
          <div class="flex flex-wrap items-center gap-3">
            <a href="/connect/"
              class="inline-block rounded-full bg-yes-deep px-6 py-3 font-medium text-white shadow-[0_8px_24px_-8px_var(--color-yes)] transition-transform hover:-translate-y-0.5">
              See it live in your Claude →
            </a>
            <a href="/scenario-map/"
              class="inline-block rounded-full border border-ink/20 px-6 py-3 font-medium text-ink transition-all hover:-translate-y-0.5 hover:border-yes-deep hover:text-yes-deep">
              Get your scenario map →
            </a>
          </div>
          <p class="mt-2 font-mono text-meta text-ink-faint">
            demo: one link, any claude plan, free included · map: free, before any contract
          </p>
          <p class="mt-5 font-mono text-meta text-ink-soft">
            built and run by <a href="/about/" class="link-und text-ink">Serhii Kravchenko</a>
          </p>
        </div>
      </div>

      <div class="rise" style="--i:4">
        <HeroChatStories lang="en" />
      </div>
    </div>
  </section>

  <!-- ── hosts ticker ────────────────────────── -->
  <div class="border-y border-ink/10 bg-paper-deep py-3">
    <div class="overflow-hidden" aria-hidden="true">
      <div class="ticker flex w-max gap-10 font-mono text-xs tracking-widest text-ink-soft uppercase">
        {[...customerHosts, ...customerHosts, ...customerHosts].map((h) => (
