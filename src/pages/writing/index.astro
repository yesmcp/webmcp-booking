---
import { getCollection } from "astro:content";
import { expandDataTokens } from "../../lib/census";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const sorted = (await getCollection("writing")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
// Blurbs may carry {{census:...}} tokens — see src/lib/census.ts.
const posts = await Promise.all(
  sorted.map(async (p) => ({ ...p, blurb: await expandDataTokens(p.data.blurb, "en") }))
);
// Presentation split (2026-08-30, showcase pivot; board-adjudicated): the
// first-person field notes are the CORE genre and lead the page; the census
// guide is a standing DATA asset pinned in its own card below, not mixed into
// the chronology — its dateModified bumps weekly, so any date sort would pin
// it to the top forever and bury the notes, which is the exact defect this
// layout replaces. A future data article joins `dataPosts` by omitting
// `engineeringNote`; a future field note or essay sets `engineeringNote: true`.
const notes = posts.filter((p) => p.data.engineeringNote);
const dataPosts = posts.filter((p) => !p.data.engineeringNote);
---

<Layout
  title="Writing: notes from a production MCP server | yesmcp"
  description="First-person notes from a Model Context Protocol server that runs in production: what the host really delivers, what the spec costs, and what a tool result may not say. Every number was measured and is dated."
  ogTitle="Writing: notes from a production MCP server"
  ogDescription="Written from a server that runs in production, not from the specification."
  path="/writing/"
  alternates={{ en: "/writing/", uk: "/ua/writing/" }}
>
  <SiteNav switchHref="/ua/writing/" />

  <main class="mx-auto max-w-3xl px-5 pt-28 pb-20 sm:pt-36">
    <p class="font-mono text-xs tracking-widest text-ink-faint uppercase">notes from production</p>
    <h1 class="mt-3 font-display text-[clamp(1.8rem,5vw,3rem)] leading-tight font-800">Writing</h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I'm <a href="/about/" class="link-und text-ink">Serhii Kravchenko</a>, and each of
      these notes started as something that broke, surprised me, or contradicted the
      documentation while I was building and running our connectors. The numbers were
      measured on my own production server and can be reproduced.
    </p>

    <ul class="mt-12 space-y-4">
      {notes.map((post) => (
        <li>
          <article class="relative rounded-2xl border border-ink/10 bg-white/40 p-6 transition-all hover:-translate-y-1 hover:border-yes/40 hover:shadow-[0_16px_40px_-16px_rgba(11,157,78,0.35)] sm:p-7">
            <p class="font-mono text-meta text-yes-deep">
              <time datetime={post.data.date}>{post.data.date}</time>
            </p>
            <h2 class="mt-3 font-display text-lg leading-snug font-600">
              {/* Stretched link: the ::after overlay makes the whole card the tap target. */}
              <a href={`/writing/${post.id}/`} class="link-und after:absolute after:inset-0">{post.data.headline}</a>
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{post.blurb}</p>
          </article>
        </li>
      ))}
    </ul>

    {dataPosts.length > 0 && (
      <section class="mt-14">
        <h2 class="font-mono text-xs tracking-widest text-ink-faint uppercase">Data · updated weekly</h2>
        <ul class="mt-4 space-y-4">
          {dataPosts.map((post) => (
            <li>
              <article class="relative rounded-2xl border border-yes-deep/25 bg-white/40 p-6 transition-all hover:-translate-y-1 hover:border-yes/50 hover:shadow-[0_16px_40px_-16px_rgba(11,157,78,0.35)] sm:p-7">
                <p class="font-mono text-meta text-yes-deep">
                  hand-counted census · <time datetime={post.data.dateModified}>{post.data.dateModified}</time>
                </p>
                <h3 class="mt-3 font-display text-lg leading-snug font-600">
                  <a href={`/writing/${post.id}/`} class="link-und after:absolute after:inset-0">{post.data.headline}</a>
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{post.blurb}</p>
                {/* The dataset link must stay a real link even under the card's
                    stretched-link overlay, hence the relative z-index. */}
                <p class="relative z-10 mt-3 font-mono text-meta">
                  <a href="/data/directory.json" class="link-und text-ink-soft">open dataset · /data/directory.json · CC BY 4.0</a>
                </p>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-14 border-t border-ink/10 pt-7 font-mono text-sm">
      <a href="/" class="link-und text-ink-soft">← Back to the front page</a>
    </p>
  </main>

  <SiteFooter switchHref="/ua/writing/" />
</Layout>
