          <div aria-hidden="true" class="relative bg-paper-deep">
            <div class="coin-edge h-10"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="rounded-full border border-ink/15 bg-paper-deep px-3.5 py-1 font-mono text-stamp tracking-widest text-ink-faint uppercase">один конектор · два боки</span>
            </div>
          </div>
        )}
        <div class={`px-5 py-10 sm:px-8 ${shelf.dark ? "bg-ink" : "bg-paper"}`}>
          <p class={`reveal flex items-center gap-2 font-mono text-xs tracking-widest uppercase ${shelf.dark ? "text-paper/50" : "text-ink-faint"}`}>
            <span aria-hidden="true" class={`h-2 w-2 shrink-0 rounded-full ${shelf.dark ? "bg-yes-bright" : "border border-yes-deep"}`}></span>
            {shelf.label}
            <span class={shelf.dark ? "text-paper/55" : "text-ink-faint"}>· {shelf.status}</span>
          </p>
          {shelf.note && <p class={`reveal mt-3 max-w-2xl text-sm leading-relaxed ${shelf.dark ? "text-paper/60" : "text-ink-soft"}`}>{shelf.note}</p>}
          {shelf.strip && (
            <div class="reveal mt-4 flex flex-wrap items-center gap-2 font-mono text-meta text-paper/70">
