---
import Layout from "../../layouts/Layout.astro";
import LangTag from "../../components/LangTag.astro";
import SiteLogo from "../../components/SiteLogo.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import HeroChatStories from "../../components/HeroChatStories.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import BelieverGate from "../../components/BelieverGate.astro";
import TwoFaces from "../../components/TwoFaces.astro";
import { siClaudecode, siGooglegemini, siPerplexity, siGithubcopilot, siOllama } from "simple-icons";

// Ukrainian home page. Mirrors ../index.astro section for section — when the
// English page changes, this file changes in the same commit (see CLAUDE.md).
// Copy voice: native Ukrainian product copy (monobank-school rhythm: short,
// verb-first, conversational), NOT a translation calque. Owner rule: no em/en
// dashes in the visible text.
// Чотири питання, які власник ставить перед тим, як написати нам.
// Оголошені тут, бо вузол FAQPage нижче будується саме з цього масиву:
// один дім для факту, тож сторінка і структуровані дані не розійдуться.
const faqs = [
  {
    q: "Хіба мій розробник не зробить це сам?",
    a: "Зробить. Питання не в тому, хто пише сервер: питання в тому, хто вирішує, які п'ять запитань ваших клієнтів мають жити в чаті, де проходить межа, яку асистент не переступає ніколи, і хто дивиться в п'ятницю ввечері, коли сценарій починає відповідати неправильно. Саме над цим ми працюємо разом із вашими розробниками.",
  },
  {
    q: "Як саме мої клієнти отримають конектор?",
    a: "У Claude все просто: сторінка з одним посиланням, клієнт додає ваш конектор за хвилину, на будь-якому тарифі. У ChatGPT шлях лежить через офіційний каталог застосунків: OpenAI переглядає кожну заявку, і коли ви захочете місце там, ми готуємо вашу заявку і проводимо її через рев'ю. Ми чесно кажемо, що працює вже сьогодні, а що ще чекає на рев'ю.",
  },
  {
    q: "Що з нашими даними й безпекою?",
    a: "Ваші дані живуть у ваших системах: конектор читає їх з обмеженими правами, прямого доступу до бази немає. Читання і запис розділені, незворотні дії просять підтвердження перед запуском. Гостьова бронь зберігає ім'я та email, і все; коли сценарію справді потрібна особистість, ми будуємо його на OAuth 2.1, і це теж працює наживо. А ще ми атакуємо власний сервер підробленими заголовками й ворожими запитами раніше, ніж це спробує хтось інший.",
  },
  {
    q: "Скільки це коштує і чому тут немає ціни?",
    a: "Бо кожен конектор будується під один бізнес, і число без цього обсягу було б вигадкою. Діагностика безкоштовна, і з цього безкоштовного кроку ви виходите з числом для свого випадку. Замість прайсу два зобов'язання: якщо перший сценарій виявиться не тим, наступний будуємо з вашої мапи без доплати; а проти системи з API перший сценарій займає близько двох тижнів.",
  },
  {
    q: "Чи не прив'яжусь я до вас?",
    a: "Ні. Специфікація і код ваші з першого дня, і ви можете перенести конектор на свої сервери, коли захочете. Ми тримаємо клієнтів роботою, а не замком.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://yesmcp.com/#organization",
      name: "Yes MCP",
      alternateName: "yesmcp",
      url: "https://yesmcp.com/",
      email: "yes@yesmcp.com",
      description:
        "Yes MCP проєктує, запускає і супроводжує конектори Model Context Protocol для бізнесів, щоб їхні клієнти могли бронювати, замовляти, перевіряти статус і отримувати підтримку всередині ШІ-чатів, таких як Claude і ChatGPT.",
      founder: { "@id": "https://yesmcp.com/#serhii" },
      sameAs: [
        "https://www.linkedin.com/company/yesmcp/",
        "https://github.com/yesmcp",
        "https://x.com/YesMCPapp",
