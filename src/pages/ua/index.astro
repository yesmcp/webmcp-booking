                }`}
                style={`--r:${(i % 3) * 0.1}s`}>
                <p class={`font-mono text-meta ${shelf.dark ? "text-paper/55" : "text-ink-faint"}`}>{c.tag}</p>
                <p class={`mt-3 ${shelf.dark ? "text-paper" : "text-ink"}`}>«{c.quote}»</p>
