                <p class={`mt-3 text-sm leading-relaxed ${shelf.dark ? "text-paper/60" : "text-ink-soft"}`}>{c.result}</p>
                <div class={`mt-auto flex flex-wrap gap-1.5 pt-4 font-mono text-stamp ${shelf.dark ? "text-paper/70" : "text-ink-soft"}`}>
