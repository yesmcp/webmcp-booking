---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="Not found | yesmcp"
  description="That page isn't here. Either it moved, or it never existed."
  path="/404.html"
  noindex={true}
>
  <SiteNav />

  <main class="mx-auto max-w-3xl px-5 pt-32 pb-24 sm:pt-44">
    <p class="font-mono text-xs tracking-widest text-ink-faint uppercase">404</p>
    <h1 class="mt-3 font-display text-[clamp(1.8rem,5vw,3rem)] leading-tight font-800">
      That page isn't here
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
      Either it moved, or it never existed. Everything that does exist is one link away.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href="/"
        class="rounded-full bg-yes-deep px-6 py-3 font-medium text-white shadow-[0_8px_24px_-8px_var(--color-yes)] transition-transform hover:-translate-y-0.5"
      >
        Front page
      </a>
      <a href="/writing/" class="link-und text-ink-soft">Writing</a>
      <a href="/about/" class="link-und text-ink-soft">About</a>
    </div>
  </main>

  <SiteFooter />
</Layout>
