---
import LangTag from "./LangTag.astro";
import SiteLogo from "./SiteLogo.astro";

interface Props {
  /** Tailwind max-width class for the nav row, matched to the page's own column. */
  width?: string;
  /** Content language of the hosting page. */
  lang?: "en" | "uk";
  /** Path of the same page in the other language; renders the language tag. */
  switchHref?: string;
}
const { width = "max-w-3xl", lang = "en", switchHref } = Astro.props;
const home = lang === "uk" ? "/ua/" : "/";
const t =
  lang === "uk"
    ? { try: "Спробуйте", writing: "Нотатки", about: "Про мене", contact: "Контакт" }
    : { try: "Try it", writing: "Writing", about: "About", contact: "Contact" };
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-ink/10 bg-paper/80 backdrop-blur-md">
  <nav class={`relative mx-auto flex ${width} items-center justify-between gap-5 px-5 py-3.5`}>
    <a href={home} aria-label="yesmcp">
      <SiteLogo className="h-[22px] w-auto" />
    </a>
    <div class="flex items-center gap-6 text-sm text-ink-soft">
      <a href={lang === "uk" ? "/ua/connect/" : "/connect/"} class="link-und text-yes-deep">{t.try}</a>
      <a href={lang === "uk" ? "/ua/writing/" : "/writing/"} class="link-und">{t.writing}</a>
      <a href={lang === "uk" ? "/ua/about/" : "/about/"} class="link-und">{t.about}</a>
      <a href={`${home}#contact`} class="link-und hidden sm:inline">{t.contact}</a>
    </div>
    {switchHref && <LangTag target={lang === "uk" ? "en" : "uk"} href={switchHref} />}
  </nav>
</header>
