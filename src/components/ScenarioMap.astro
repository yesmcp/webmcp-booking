---
/**
 * The body of /scenario-map/ and /ua/scenario-map/.
 *
 * Both routes render THE SAME structure section for section, so the markup
 * lives here once and each page passes its own data file plus its chrome
 * strings. Every customer-visible sentence comes from the data file (English =
 * verbatim connector content, Ukrainian = src/data/diagnostic.uk.json); this
 * component composes no copy of its own beyond what the page hands it.
 *
 * Progressive enhancement: all seven maps are in the HTML before any script
 * runs, as a <details> browse list, and every wizard card is a plain anchor
 * into that list. scripts/scenario-map.js upgrades the same markup into a
 * two-step wizard; with JS off nothing is lost.
 */
import { boldToHtml, botLink, type Diagnostic } from "../lib/scenario-map";

export interface ChromeStrings {
  eyebrow: string;
  heading: string;
  intro: string;
  step1: string;
  otherTitle: string;
  otherText: string;
  step2: string;
  resultHeading: string;
  customersShelf: string;
  teamShelf: string;
  browseHeading: string;
  browseHint: string;
  ctaHeading: string;
  ctaText: string;
  ctaPrimary: string;
  ctaSecondary: string;
  verdict: { green: string; yellow: string };
  change: string;
}

interface Props {
  data: Diagnostic;
  t: ChromeStrings;
  /** Where the secondary CTA points: /connect/ or /ua/connect/. */
  connectHref: string;
  /**
   * Verticals that have a landing page of their own, keyed by vertical id.
   * The link is rendered INSIDE the map body, which is the one place that
   * serves both entrances: the browse list renders it as-is, and the wizard
   * clones this same body into the assembled result (public/js/scenario-map.js).
   * Verticals without a page simply get nothing.
   */
  verticalPages?: Record<string, { href: string; label: string }>;
}

const { data, t, connectHref, verticalPages = {} } = Astro.props;

const CARD =
  "rounded-2xl border border-ink/10 bg-white/40 p-5 transition-all hover:-translate-y-0.5 hover:border-yes/40 hover:shadow-[0_16px_40px_-16px_rgba(11,157,78,0.35)]";
const CHIP: Record<string, string> = {
  green: "border-yes-deep/40 bg-yes/10 text-yes-deep",
  yellow: "border-amber/60 bg-amber/15 text-ink",
};
---

<main class="mx-auto max-w-4xl px-5 pt-28 pb-24 sm:pt-36">
  <p class="font-mono text-xs tracking-widest text-ink-faint uppercase">{t.eyebrow}</p>
  <h1 class="mt-3 font-display text-[clamp(1.8rem,5vw,3rem)] leading-tight font-800">{t.heading}</h1>
  <p class="mt-6 text-lg leading-relaxed text-ink-soft">{t.intro}</p>

  <!-- ── step 1: business type ─────────────────── -->
  <section id="step-1" class="mt-14">
    <h2 class="font-display text-xl font-600">{t.step1}</h2>
    <div data-step-body class="mt-5 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
      {data.verticals.map((v) => (
        <a href={`#map-${v.id}`} data-vertical={v.id} class={`${CARD} block p-4 font-600 text-card leading-snug text-ink`}>{v.title}</a>
      ))}
      <a href="#talk" data-vertical-other class={`${CARD} block p-4 sm:col-span-2 md:col-span-3`}>
        <span class="font-600 text-card text-ink">{t.otherTitle}</span>
        <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{t.otherText}</span>
      </a>
    </div>
  </section>

  <!-- ── step 2: the two intake questions ──────── -->
  <section id="step-2" class="mt-14">
    <h2 class="font-display text-xl font-600">{t.step2}</h2>
    {data.questions.map((q) => (
      <fieldset data-question={q.id} class="mt-7 border-0 p-0">
        <legend class="p-0 font-600 text-ink">{q.ask}</legend>
        <div data-step-body class="mt-3 space-y-2.5">
          {Object.entries(q.options).map(([key, label]) => (
            <label class="flex cursor-pointer gap-3 rounded-2xl border border-ink/10 bg-white/40 px-5 py-3.5 transition-colors hover:border-yes/40">
              <input type="radio" name={q.id} value={key} data-code={data.codes[q.id]?.[key]} class="mt-1.5 shrink-0 accent-yes-deep" />
              <span class="block">
                <span class="block leading-relaxed text-ink">{label}</span>
                {q.id === "systems" && (
                  <span
                    data-feasibility={key}
                    data-verdict={data.feasibility[key]!.verdict}
                    class="mt-1.5 block text-sm leading-relaxed text-ink-faint">{data.feasibility[key]!.note}</span>
                )}
                {q.id === "customer_channel" && (
                  <span
                    data-channel-note={key}
                    class="mt-1.5 block text-sm leading-relaxed text-ink-faint">{data.channelNotes[key]}</span>
                )}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
  </section>

  <!-- ── result: assembled by the script from the markup below ── -->
  <section id="result" data-result hidden class="mt-14 scroll-mt-24">
    <h2 class="font-display text-xl font-600">{t.resultHeading}</h2>
    <div data-result-slot class="mt-5"></div>
  </section>

  <!-- ── all seven maps, server-rendered ───────── -->
  <section id="browse" data-browse class="mt-14">
    <h2 class="font-display text-xl font-600">{t.browseHeading}</h2>
    <p class="mt-2 leading-relaxed text-ink-soft">{t.browseHint}</p>
    <div class="mt-5 space-y-3">
      {data.verticals.map((v) => (
        <details id={`map-${v.id}`} data-map={v.id} class="scroll-mt-24 rounded-2xl border border-ink/10 bg-white/40 px-6 py-4">
          <summary class="cursor-pointer list-none font-600 marker:content-none">
            <span class="mr-2 font-mono text-yes-deep">→</span>{v.title}
          </summary>
          <div data-map-body class="mt-5">
            <h3 data-map-title class="font-display text-lg font-600">{v.title}</h3>
            <div data-verdict-slot></div>
            <div class="mt-5 md:grid md:grid-cols-2 md:gap-x-10">
              <div>
                <p class="font-mono text-xs tracking-widest text-ink-faint uppercase">{t.customersShelf}</p>
                <ul class="mt-3 space-y-2.5">
                  {v.customers.map((bullet) => (
                    <li class="relative pl-5 text-card leading-relaxed text-ink-soft">
                      <span class="absolute left-0 font-mono text-sm text-yes-deep" aria-hidden="true">→</span><span set:html={boldToHtml(bullet)} />
                    </li>
                  ))}
                </ul>
              </div>
              <div class="mt-6 md:mt-0">
                <p class="font-mono text-xs tracking-widest text-ink-faint uppercase">{t.teamShelf}</p>
                <ul class="mt-3 space-y-2.5">
                  {v.team.map((bullet) => (
                    <li class="relative pl-5 text-card leading-relaxed text-ink-soft">
                      <span class="absolute left-0 font-mono text-sm text-yes-deep" aria-hidden="true">→</span><span set:html={boldToHtml(bullet)} />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            {verticalPages[v.id] && (
              <p class="mt-6 rounded-2xl border border-dashed border-yes-deep/35 px-5 py-3.5 text-card leading-relaxed text-ink-soft">
                <a href={verticalPages[v.id]!.href} class="link-und text-yes-deep">{verticalPages[v.id]!.label} →</a>
              </p>
            )}
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={botLink(v.id)} class="inline-block rounded-full bg-yes-deep px-6 py-3 font-medium text-white shadow-[0_8px_24px_-8px_var(--color-yes)] transition-transform hover:-translate-y-0.5">{t.ctaPrimary}</a>
              <a href={connectHref} class="link-und text-ink">{t.ctaSecondary}</a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- ── CTA block, always visible ─────────────── -->
  <section id="talk" class="mt-14 scroll-mt-24 rounded-2xl border border-yes-deep/25 bg-white/40 p-6">
    <h2 class="font-display text-xl font-600">{t.ctaHeading}</h2>
    <p class="mt-3 leading-relaxed text-ink-soft">{t.ctaText}</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href={botLink()} class="inline-block rounded-full bg-yes-deep px-6 py-3 font-medium text-white shadow-[0_8px_24px_-8px_var(--color-yes)] transition-transform hover:-translate-y-0.5">{t.ctaPrimary}</a>
      <a href={connectHref} class="link-und text-ink">{t.ctaSecondary}</a>
    </div>
  </section>

  {/* Verdict chip templates: the script clones one into the assembled map. */}
  <template data-verdict-template="green"><p class={`mt-3 inline-block rounded-full border px-3.5 py-1 font-mono text-xs ${CHIP.green}`}>{t.verdict.green}</p></template>
  <template data-verdict-template="yellow"><p class={`mt-3 inline-block rounded-full border px-3.5 py-1 font-mono text-xs ${CHIP.yellow}`}>{t.verdict.yellow}</p></template>

  {/* Collapsed-step summary row: the script fills the label and wires the button. */}
  <template data-summary-template>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl border border-yes/30 bg-yes/5 px-5 py-3">
      <span class="font-mono text-sm text-yes-deep" aria-hidden="true">✓</span>
      <span data-summary-label class="font-600 text-card text-ink"></span>
      <button type="button" data-summary-change class="link-und ml-auto cursor-pointer border-0 bg-transparent p-0 text-sm text-ink-soft">{t.change}</button>
    </div>
  </template>
</main>

{/* Served from public/, like the site's other four scripts: Astro INLINES a
    bundled script under ~4 KB, and the CSP here is `script-src 'self'` plus one
    hash for the Layout bootstrap, so an inlined bundle would simply be blocked. */}
<script is:inline type="module" src="/js/scenario-map.js"></script>
